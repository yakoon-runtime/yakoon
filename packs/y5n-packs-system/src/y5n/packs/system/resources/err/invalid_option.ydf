<text>{{ state.reason }}</text>

<space count="1"/>
<text>Usage:</text>

<list>
{% for usage in state.usages %}
  <item>
    <cmd command="..." variant="usage">
        {{ usage.key }}

        {% if usage.action %}
           {{ usage.action }}
        {% endif %}

        {% for arg in usage.args %}
          <arg>{{ arg }}</arg>
        {% endfor %}

        {% for opt in usage.options %}
           --{{ opt }} 
           <arg>{{ opt }}</arg>
        {% endfor %}

        {% for flag in usage.flags %}
           --{{ flag }}
        {% endfor %}
    </cmd>
  </item>
{% endfor %}
</list>
